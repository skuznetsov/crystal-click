require "./spec_helper"

private def w196a_u64(value : UInt64) : Bytes
  Bytes.new(8) { |index| ((value >> (8 * index)) & 255_u64).to_u8 }
end

private def w196a_join(parts : Array(Bytes)) : Bytes
  size = parts.sum(&.size)
  output = Bytes.new(size)
  offset = 0
  parts.each do |part|
    output[offset, part.size].copy_from(part)
    offset += part.size
  end
  output
end

private def w196a_events(entries : Array(Tuple(String, UInt64))) : Array(CrystalClick::ObjectSharedPathSubstreamEvent)
  entries.map { |entry| CrystalClick::ObjectSharedPathSubstreamEvent.new(entry[0], entry[1]) }
end

private def w196a_limits(max_bytes : Int = 1_048_576) : CrystalClick::BinaryCodecLimits
  CrystalClick::BinaryCodecLimits.new(64, 4_096, 100_000, max_bytes)
end

private def w196a_lane_bytes(
  data : Bytes,
  events : Array(CrystalClick::ObjectSharedPathSubstreamEvent),
  event_index : Int,
) : Bytes
  start = events[event_index].relative_offset.to_i
  finish = if following = events[event_index + 1]?
             following.relative_offset.to_i
           else
             data.size
           end
  data[start, finish - start]
end

describe "W196 shared-path LowCardinality adversarial literals" do
  it "decodes an independently authored additional-keys-only Dynamic LC tape" do
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 1)
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    lc = CrystalClick::BinaryDataType.low_cardinality(uint8)

    # Dynamic V3 structure (actual LC arm), discriminator prefix, LC v1
    # prefix, COMPACT discriminator body [LC, NULL, LC], then an additional-
    # keys-only index record for 7 and 9. This differs from the writer's
    # canonical global-dictionary record and is not generated by that writer.
    data = w196a_join([
      w196a_u64(4_u64), Bytes[1, 0x26, 0x01],
      w196a_u64(1_u64), w196a_u64(1_u64),
      Bytes[3, 0, 0, 255, 0],
      w196a_u64(0x600_u64), w196a_u64(2_u64), Bytes[7, 9],
      w196a_u64(2_u64), Bytes[0, 1],
    ])
    data.size.should eq(60)
    expected_events = [
      {".dynamic_structure", 0_u64},
      {".variant_discr_prefix", 11_u64},
      {".LowCardinality(UInt8).dict_prefix", 19_u64},
      {".variant_discr", 27_u64},
      {".LowCardinality(UInt8).dict", 32_u64},
      {".LowCardinality(UInt8)", 32_u64},
      {".SharedVariant.size", 60_u64},
      {".SharedVariant", 60_u64},
    ] of Tuple(String, UInt64)
    events = w196a_events(expected_events)

    decoded = CrystalClick::ObjectSharedPathCodec.decode(data, events, 3, dynamic)
    decoded.size.should eq(3)
    decoded[0].child_at(0).type.should eq(lc)
    decoded[0].child_at(0).child_at(0).byte_at(0).should eq(7_u8)
    decoded[1].is_null?.should be_true
    decoded[2].child_at(0).type.should eq(lc)
    decoded[2].child_at(0).child_at(0).byte_at(0).should eq(9_u8)

    structure = CrystalClick::DynamicStructure.new([lc] of CrystalClick::BinaryDataType)
    writer_rows = [decoded[0], decoded[1], decoded[2]] of CrystalClick::BinaryValue
    canonical = CrystalClick::ObjectSharedPathCodec.encode(dynamic, {"root" => structure}, writer_rows)
    canonical.data.should_not eq(data)
    dictionary_event = canonical.events.index do |event|
      event.name == ".LowCardinality(UInt8).dict"
    end || raise "W196 writer omitted the LC dictionary-body callback"
    index_event = canonical.events.index do |event|
      event.name == ".LowCardinality(UInt8)"
    end || raise "W196 writer omitted the LC indexes callback"
    w196a_lane_bytes(canonical.data, canonical.events, dictionary_event).should be_empty
    index_bytes = w196a_lane_bytes(canonical.data, canonical.events, index_event)
    index_bytes[0, 8].should eq(w196a_u64(0x600_u64))
    roundtrip = CrystalClick::ObjectSharedPathCodec.decode(canonical.data, canonical.events, 3, dynamic)
    roundtrip[0].child_at(0).child_at(0).byte_at(0).should eq(7_u8)
    roundtrip[1].is_null?.should be_true
    roundtrip[2].child_at(0).child_at(0).byte_at(0).should eq(9_u8)
  end

  it "retains equal-offset callbacks for an empty Array LC arm and a truly empty path" do
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 1)
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    lc = CrystalClick::BinaryDataType.low_cardinality(uint8)
    array = CrystalClick::BinaryDataType.array(lc)

    # One selected empty Array followed by Dynamic NULL. The array size lane
    # contains one zero UInt64; the unused LC arm still has prefix/body/index
    # callbacks, all at the same final offset.
    data = w196a_join([
      w196a_u64(4_u64), Bytes[1, 0x1e, 0x26, 0x01],
      w196a_u64(1_u64), w196a_u64(1_u64),
      Bytes[2, 0, 0, 255], w196a_u64(0_u64),
    ])
    data.size.should eq(40)
    expected_events = [
      {".dynamic_structure", 0_u64},
      {".variant_discr_prefix", 12_u64},
      {".Array(LowCardinality(UInt8)).dict_prefix", 20_u64},
      {".variant_discr", 28_u64},
      {".Array(LowCardinality(UInt8)).size0", 32_u64},
      {".Array(LowCardinality(UInt8)).dict", 40_u64},
      {".Array(LowCardinality(UInt8))", 40_u64},
      {".SharedVariant.size", 40_u64},
      {".SharedVariant", 40_u64},
    ] of Tuple(String, UInt64)
    events = w196a_events(expected_events)
    decoded = CrystalClick::ObjectSharedPathCodec.decode(data, events, 2, dynamic)
    decoded[0].child_at(0).type.should eq(array)
    decoded[0].child_at(0).child_count.should eq(0)
    decoded[1].is_null?.should be_true

    no_rows = CrystalClick::ObjectSharedPathCodec.encode(
      dynamic,
      {"root" => CrystalClick::DynamicStructure.new([array] of CrystalClick::BinaryDataType)},
      [] of CrystalClick::BinaryValue,
    )
    no_rows.data.should eq(w196a_join([
      w196a_u64(4_u64), Bytes[1, 0x1e, 0x26, 0x01],
      w196a_u64(1_u64), w196a_u64(1_u64),
    ]))
    no_rows.events.map { |event| {event.name, event.relative_offset} }.should eq([
      {".dynamic_structure", 0_u64},
      {".variant_discr_prefix", 12_u64},
      {".Array(LowCardinality(UInt8)).dict_prefix", 20_u64},
      {".variant_discr", 28_u64},
      {".Array(LowCardinality(UInt8)).size0", 28_u64},
      {".Array(LowCardinality(UInt8)).dict", 28_u64},
      {".Array(LowCardinality(UInt8))", 28_u64},
      {".SharedVariant.size", 28_u64},
      {".SharedVariant", 28_u64},
    ] of Tuple(String, UInt64))
    CrystalClick::ObjectSharedPathCodec.decode(no_rows.data, no_rows.events, 0, dynamic).should be_empty
  end

  it "rejects malformed LC prefixes, event tapes, and out-of-range additional IDs" do
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 1)
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    lc = CrystalClick::BinaryDataType.low_cardinality(uint8)
    data = w196a_join([
      w196a_u64(4_u64), Bytes[1, 0x26, 0x01],
      w196a_u64(1_u64), w196a_u64(1_u64), Bytes[3, 0, 0, 255, 0],
      w196a_u64(0x600_u64), w196a_u64(2_u64), Bytes[7, 9],
      w196a_u64(2_u64), Bytes[0, 1],
    ])
    entries = [
      {".dynamic_structure", 0_u64},
      {".variant_discr_prefix", 11_u64},
      {".LowCardinality(UInt8).dict_prefix", 19_u64},
      {".variant_discr", 27_u64},
      {".LowCardinality(UInt8).dict", 32_u64},
      {".LowCardinality(UInt8)", 32_u64},
      {".SharedVariant.size", 60_u64},
      {".SharedVariant", 60_u64},
    ] of Tuple(String, UInt64)
    decode = ->(bytes : Bytes, tape : Array(CrystalClick::ObjectSharedPathSubstreamEvent)) {
      CrystalClick::ObjectSharedPathCodec.decode(bytes, tape, 3, dynamic)
    }

    bad_version = data.dup
    bad_version[19] = 2_u8
    expect_raises(CrystalClick::UnsupportedFormatError) { decode.call(bad_version, w196a_events(entries)) }

    bad_id = data.dup
    bad_id[59] = 2_u8
    expect_raises(CrystalClick::CorruptPartError) { decode.call(bad_id, w196a_events(entries)) }

    reordered = w196a_events(entries)
    reordered[4], reordered[5] = reordered[5], reordered[4]
    expect_raises(CrystalClick::CorruptPartError) { decode.call(data, reordered) }

    missing_prefix = w196a_events(entries)
    missing_prefix.delete_at(2)
    expect_raises(CrystalClick::CorruptPartError) { decode.call(data, missing_prefix) }

    duplicate_prefix = w196a_events(entries)
    duplicate_prefix.insert(3, CrystalClick::ObjectSharedPathSubstreamEvent.new(entries[2][0], 19_u64))
    expect_raises(CrystalClick::CorruptPartError) { decode.call(data, duplicate_prefix) }

    truncated = data[0, data.size - 1]
    expect_raises(CrystalClick::CorruptPartError) { decode.call(truncated, w196a_events(entries)) }

    trailing = w196a_events(entries)
    trailing << CrystalClick::ObjectSharedPathSubstreamEvent.new(".unexpected", data.size.to_u64)
    expect_raises(CrystalClick::CorruptPartError) { decode.call(data, trailing) }
  end

  it "composes sibling LC sites beneath Tuple, Map, and Nullable with both ordinary String profiles" do
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    string = CrystalClick::BinaryDataType.primitive("String")
    lc8 = CrystalClick::BinaryDataType.low_cardinality(uint8)
    lc_string = CrystalClick::BinaryDataType.low_cardinality(string)
    pair = CrystalClick::BinaryDataType.tuple([lc8, lc_string], ["count", "label"])
    nullable_pair = CrystalClick::BinaryDataType.nullable(pair)
    map = CrystalClick::BinaryDataType.map(string, lc_string)
    actual = CrystalClick::BinaryDataType.tuple([nullable_pair, map, string], ["maybe", "labels", "ordinary"])
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 1)

    count_value = CrystalClick::BinaryValue.low_cardinality(lc8, CrystalClick::BinaryValue.fixed(uint8, Bytes[7]))
    label_value = CrystalClick::BinaryValue.low_cardinality(lc_string, CrystalClick::BinaryValue.string("dict"))
    pair_value = CrystalClick::BinaryValue.tuple(pair, [count_value, label_value])
    nullable_value = CrystalClick::BinaryValue.nullable(nullable_pair, pair_value)
    map_value = CrystalClick::BinaryValue.map(map, [
      CrystalClick::BinaryValue.string("key"),
      CrystalClick::BinaryValue.low_cardinality(lc_string, CrystalClick::BinaryValue.string("map")),
    ])
    actual_value = CrystalClick::BinaryValue.tuple(actual, [nullable_value, map_value, CrystalClick::BinaryValue.string("plain")])
    rows = [
      CrystalClick::BinaryValue.dynamic(dynamic, actual_value),
      CrystalClick::BinaryValue.dynamic(dynamic),
    ] of CrystalClick::BinaryValue
    structures = {"root" => CrystalClick::DynamicStructure.new([actual] of CrystalClick::BinaryDataType)}

    compact = CrystalClick::ObjectSharedPathCodec.encode(dynamic, structures, rows, profile: CrystalClick::BinaryBulkProfile.with_size_stream)
    single = CrystalClick::ObjectSharedPathCodec.encode(dynamic, structures, rows, profile: CrystalClick::BinaryBulkProfile.single_stream)
    compact.events.count { |event| event.name.ends_with?(".dict_prefix") }.should eq(3)
    compact.events.count { |event| event.name.ends_with?(".dict") }.should eq(3)
    single.events.count { |event| event.name.ends_with?(".dict_prefix") }.should eq(3)
    single.events.count { |event| event.name.ends_with?(".dict") }.should eq(3)
    ordinary_size = ".Tuple(maybe Nullable(Tuple(count LowCardinality(UInt8), label LowCardinality(String))), labels Map(String, LowCardinality(String)), ordinary String)%2Eordinary.size"
    compact.events.map(&.name).should contain(ordinary_size)
    single.events.map(&.name).should_not contain(ordinary_size)

    dictionary_bodies = compact.events.each_index.select { |index| compact.events[index].name.ends_with?(".dict") }.map do |index|
      {compact.events[index].name, w196a_lane_bytes(compact.data, compact.events, index)}
    end.to_h
    single_dictionary_bodies = single.events.each_index.select { |index| single.events[index].name.ends_with?(".dict") }.map do |index|
      {single.events[index].name, w196a_lane_bytes(single.data, single.events, index)}
    end.to_h
    dictionary_bodies.should eq(single_dictionary_bodies)

    [
      {compact, CrystalClick::BinaryBulkProfile.with_size_stream},
      {single, CrystalClick::BinaryBulkProfile.single_stream},
    ].each do |encoded, profile|
      decoded = CrystalClick::ObjectSharedPathCodec.decode(encoded.data, encoded.events, 2, dynamic, profile: profile)
      tuple = decoded[0].child_at(0)
      tuple.type.should eq(actual)
      count_lc = tuple.child_at(0).child_at(0).child_at(0)
      count_lc.type.should eq(lc8)
      count_lc.child_at(0).byte_at(0).should eq(7_u8)
      label_lc = tuple.child_at(0).child_at(0).child_at(1)
      label_lc.type.should eq(lc_string)
      label_lc.child_at(0).as_string.should eq("dict")
      map_lc = tuple.child_at(1).child_at(1)
      map_lc.type.should eq(lc_string)
      map_lc.child_at(0).as_string.should eq("map")
      tuple.child_at(2).as_string.should eq("plain")
      decoded[1].is_null?.should be_true
    end
  end

  it "charges repeated encode and decode through the caller-owned cumulative byte budget" do
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 1)
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    lc = CrystalClick::BinaryDataType.low_cardinality(uint8)
    value = CrystalClick::BinaryValue.dynamic(dynamic,
      CrystalClick::BinaryValue.low_cardinality(lc, CrystalClick::BinaryValue.fixed(uint8, Bytes[7])))
    structures = {"root" => CrystalClick::DynamicStructure.new([lc] of CrystalClick::BinaryDataType)}
    rows = [value] of CrystalClick::BinaryValue

    measured_write = CrystalClick::BinaryCodecBudget.new(w196a_limits, true)
    encoded = CrystalClick::ObjectSharedPathCodec.encode_with_budget(dynamic, structures, rows, measured_write)
    measured_write.wire_byte_count.should be > 0
    exact_write_limits = w196a_limits(measured_write.wire_byte_count.to_i)
    shared_write = CrystalClick::BinaryCodecBudget.new(exact_write_limits, true)
    CrystalClick::ObjectSharedPathCodec.encode_with_budget(dynamic, structures, rows, shared_write).data.should eq(encoded.data)
    shared_write.wire_byte_count.should eq(measured_write.wire_byte_count)
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::ObjectSharedPathCodec.encode_with_budget(dynamic, structures, rows, shared_write)
    end

    measured_read = CrystalClick::BinaryCodecBudget.new(w196a_limits)
    CrystalClick::ObjectSharedPathCodec.decode_with_budget(encoded.data, encoded.events, 1, dynamic, measured_read)
    measured_read.wire_byte_count.should be > 0
    exact_read_limits = w196a_limits(measured_read.wire_byte_count.to_i)
    shared_read = CrystalClick::BinaryCodecBudget.new(exact_read_limits)
    CrystalClick::ObjectSharedPathCodec.decode_with_budget(encoded.data, encoded.events, 1, dynamic, shared_read).size.should eq(1)
    shared_read.wire_byte_count.should eq(measured_read.wire_byte_count)
    expect_raises(CrystalClick::CorruptPartError) do
      CrystalClick::ObjectSharedPathCodec.decode_with_budget(encoded.data, encoded.events, 1, dynamic, shared_read)
    end
  end
end

private def w196a_low_u16(type : CrystalClick::BinaryDataType, value : UInt16) : CrystalClick::BinaryValue
  bytes = Bytes[(value & 0xff_u16).to_u8, (value >> 8).to_u8]
  CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.fixed(type.child_at(0), bytes))
end

private def w196a_uint32_lc_rows(
  type : CrystalClick::BinaryDataType,
  scalar_type : CrystalClick::BinaryDataType,
  count : Int,
) : Array(CrystalClick::BinaryValue)
  rows = Array(CrystalClick::BinaryValue).new(count)
  1.upto(count) do |value|
    raw = value.to_u64
    bytes = Bytes.new(4) { |index| ((raw >> (index * 8)) & 0xff_u64).to_u8 }
    rows << CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.fixed(scalar_type, bytes))
  end
  rows
end

describe "W196 AdditionalKeysOnly LowCardinality writer policy" do
  it "repeats exact key records only for nonempty marks and leaves the default global policy intact" do
    uint16 = CrystalClick::BinaryDataType.primitive("UInt16")
    type = CrystalClick::BinaryDataType.low_cardinality(uint16)
    marks = [
      [w196a_low_u16(type, 7_u16), w196a_low_u16(type, 9_u16)],
      [] of CrystalClick::BinaryValue,
      [w196a_low_u16(type, 9_u16)],
    ] of Array(CrystalClick::BinaryValue)
    additional = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
      type,
      marks,
      CrystalClick::BinaryCodecBudget.new(w196a_limits, true),
      policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
    )

    dictionary = additional.stream("root.dictionary")
    dictionary.bytes.should eq(w196a_u64(1_u64))
    dictionary.offsets.should eq([8_u64, 8_u64, 8_u64, 8_u64])
    expected_record = w196a_join([
      w196a_u64(0x600_u64), w196a_u64(3_u64), Bytes[0, 0, 7, 0, 9, 0],
      w196a_u64(2_u64), Bytes[1, 2],
    ] of Bytes)
    expected_last = w196a_join([
      w196a_u64(0x600_u64), w196a_u64(3_u64), Bytes[0, 0, 7, 0, 9, 0],
      w196a_u64(1_u64), Bytes[2],
    ] of Bytes)
    indexes = additional.stream("root.indexes")
    indexes.bytes.should eq(w196a_join([expected_record, expected_last] of Bytes))
    indexes.offsets.should eq([0_u64, 32_u64, 32_u64, 63_u64])

    decoded = CrystalClick::BinaryLowCardinalityStorageCodec.decode(type, additional, [2_u64, 0_u64, 1_u64])
    decoded.map { |mark| mark.map { |value| value.child_at(0).byte_at(0) } }.should eq([[7_u8, 9_u8], [] of UInt8, [9_u8]])

    global = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
      type,
      marks,
      CrystalClick::BinaryCodecBudget.new(w196a_limits, true),
    )
    global.stream("root.dictionary").bytes.size.should be > 8
    (global.stream("root.indexes").bytes[0, 8] == w196a_u64(0x500_u64)).should be_true
    CrystalClick::BinaryLowCardinalityStorageCodec.decode(type, global, [2_u64, 0_u64, 1_u64]).size.should eq(3)
  end

  it "preserves nullable NULL-zero/default-one slots in an inline additional-key record" do
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    nullable = CrystalClick::BinaryDataType.nullable(uint8)
    type = CrystalClick::BinaryDataType.low_cardinality(nullable)
    values = [
      CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.nullable(nullable)),
      CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.nullable(nullable, CrystalClick::BinaryValue.fixed(uint8, Bytes[0]))),
      CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.nullable(nullable, CrystalClick::BinaryValue.fixed(uint8, Bytes[9]))),
    ] of CrystalClick::BinaryValue
    encoded = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
      type,
      [values] of Array(CrystalClick::BinaryValue),
      CrystalClick::BinaryCodecBudget.new(w196a_limits, true),
      policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
    )
    encoded.stream("root.dictionary").bytes.should eq(w196a_u64(1_u64))
    encoded.stream("root.indexes").bytes.should eq(w196a_join([
      w196a_u64(0x600_u64), w196a_u64(3_u64), Bytes[0, 0, 9],
      w196a_u64(3_u64), Bytes[0, 1, 2],
    ] of Bytes))
    decoded = CrystalClick::BinaryLowCardinalityStorageCodec.decode(type, encoded, [3_u64])[0]
    decoded[0].child_at(0).is_null?.should be_true
    decoded[1].child_at(0).child_at(0).byte_at(0).should eq(0_u8)
    decoded[2].child_at(0).child_at(0).byte_at(0).should eq(9_u8)
  end

  it "preflights exact inline wire size against one caller-owned budget" do
    uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
    type = CrystalClick::BinaryDataType.low_cardinality(uint8)
    values = [7_u8, 9_u8].map do |value|
      CrystalClick::BinaryValue.low_cardinality(type, CrystalClick::BinaryValue.fixed(uint8, Bytes[value]))
    end
    marks = [values, [] of CrystalClick::BinaryValue, values] of Array(CrystalClick::BinaryValue)
    measured = CrystalClick::BinaryCodecBudget.new(w196a_limits, true)
    expected = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
      type,
      marks,
      measured,
      policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
    )
    exact = CrystalClick::BinaryCodecBudget.new(w196a_limits(measured.wire_byte_count.to_i), true)
    actual = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
      type,
      marks,
      exact,
      policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
    )
    actual.stream("root.indexes").bytes.should eq(expected.stream("root.indexes").bytes)
    exact.wire_byte_count.should eq(measured.wire_byte_count)
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
        type,
        marks,
        exact,
        policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
      )
    end
    exact.wire_byte_count.should eq(measured.wire_byte_count)

    short = CrystalClick::BinaryCodecBudget.new(w196a_limits(measured.wire_byte_count.to_i - 1), true)
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
        type,
        marks,
        short,
        policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
      )
    end
    short.wire_byte_count.should eq(0_i64)
  end

  it "selects index widths at both inline-key cardinality boundaries" do
    uint32 = CrystalClick::BinaryDataType.primitive("UInt32")
    type = CrystalClick::BinaryDataType.low_cardinality(uint32)
    all_values = w196a_uint32_lc_rows(type, uint32, 65_536)
    limits = CrystalClick::BinaryCodecLimits.new(16, 250_000, 250_000, 2_097_152)

    [
      {255, 0x600_u64},
      {256, 0x601_u64},
      {65_535, 0x601_u64},
      {65_536, 0x602_u64},
    ].each do |fixture|
      rows = Array(CrystalClick::BinaryValue).new(fixture[0]) do |index|
        all_values[index]
      end
      encoded = CrystalClick::BinaryLowCardinalityStorageEncoder.encode(
        type,
        [rows] of Array(CrystalClick::BinaryValue),
        CrystalClick::BinaryCodecBudget.new(limits, true),
        policy: CrystalClick::BinaryLowCardinalityStoragePolicy::AdditionalKeysOnly,
      )
      encoded.stream("root.indexes").bytes[0, 8].should eq(w196a_u64(fixture[1]))
    end
  end
end
