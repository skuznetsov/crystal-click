require "./spec_helper"

private def w233_qbit_type : CrystalClick::QBitType
  CrystalClick::QBitType.new("Int8", 3_u64)
end

private def w233_qbit_value(type : CrystalClick::QBitType) : CrystalClick::BinaryValue
  CrystalClick::BinaryValue.qbit(
    CrystalClick::QBitValue.new(type, Bytes[0x11_u8, 0x22, 0x33]),
  )
end

private def w233_kernel_types
  qbit_type = w233_qbit_type
  qbit = CrystalClick::BinaryDataType.qbit(qbit_type)
  uint8 = CrystalClick::BinaryDataType.primitive("UInt8")
  tuple_qbit = CrystalClick::BinaryDataType.tuple([qbit, uint8] of CrystalClick::BinaryDataType)
  map_string_qbit = CrystalClick::BinaryDataType.map(
    CrystalClick::BinaryDataType.primitive("String"), qbit,
  )
  nested_qbit = CrystalClick::BinaryDataType.nested(
    [qbit] of CrystalClick::BinaryDataType,
    ["q"] of String,
  )
  nullable_tuple_qbit = CrystalClick::BinaryDataType.nullable(
    CrystalClick::BinaryDataType.tuple([qbit] of CrystalClick::BinaryDataType),
  )
  inner_variant = CrystalClick::BinaryDataType.variant(
    [uint8, qbit] of CrystalClick::BinaryDataType,
  )

  {
    qbit_type:                 qbit_type,
    qbit:                      qbit,
    uint8:                     uint8,
    array_qbit:                CrystalClick::BinaryDataType.array(qbit),
    tuple_qbit:                tuple_qbit,
    map_string_qbit:           map_string_qbit,
    nested_qbit:               nested_qbit,
    nullable_tuple_qbit:       nullable_tuple_qbit,
    array_nullable_tuple_qbit: CrystalClick::BinaryDataType.array(nullable_tuple_qbit),
    inner_variant:             inner_variant,
    array_variant:             CrystalClick::BinaryDataType.array(inner_variant),
  }
end

private def w233_arm_path(
  structure : CrystalClick::DynamicStructure,
  type : CrystalClick::BinaryDataType,
) : String
  "root.arm.#{structure.canonical_variant_names.index(type.name).not_nil!}"
end

private def w233_dynamic_envelopes(
  rows : Array(Array(CrystalClick::BinaryValue)),
) : Array(Array(Bytes))
  rows.map do |row|
    row.map { |value| CrystalClick::BinaryValueCodec.encode(value) }
  end
end

describe "W233 recursive QBit Dynamic kernel" do
  it "reads and writes independent descriptor/payload literals through the existing recursive visitors" do
    types = w233_kernel_types
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 8)

    # Each literal is Dynamic's actual descriptor followed by the ordinary
    # RowBinary payload; none is generated by the codec under test.
    array_wire = Bytes[
      0x1e_u8, 0x36, 0x07, 0x03, 0x01, 0x03, 0x11, 0x22, 0x33,
    ]
    array_value = CrystalClick::BinaryValueCodec.decode_value(dynamic, array_wire)
    array_value.child_at(0).type.should eq(types[:array_qbit])
    array_value.child_at(0).element_at(0).qbit_value.should eq(
      CrystalClick::QBitValue.new(types[:qbit_type], Bytes[0x11_u8, 0x22, 0x33]),
    )
    CrystalClick::BinaryValueCodec.encode_value(array_value).should eq(array_wire)
    full_envelope = Bytes[0x2b_u8, 0x08_u8, 0x1e, 0x36, 0x07, 0x03, 0x01, 0x03, 0x11, 0x22, 0x33]
    CrystalClick::BinaryValueCodec.encode(array_value).should eq(full_envelope)
    CrystalClick::BinaryValueCodec.encode(CrystalClick::BinaryValueCodec.decode(full_envelope)).should eq(full_envelope)

    empty_array_wire = Bytes[0x1e_u8, 0x36, 0x07, 0x03, 0x00]
    empty_array = CrystalClick::BinaryValueCodec.decode_value(dynamic, empty_array_wire)
    empty_array.child_at(0).element_count.should eq(0)
    CrystalClick::BinaryValueCodec.encode_value(empty_array).should eq(empty_array_wire)

    tuple_wire = Bytes[
      0x1f_u8, 0x02, 0x36, 0x07, 0x03, 0x01, 0x03, 0x11, 0x22, 0x33, 0x07,
    ]
    tuple_value = CrystalClick::BinaryValueCodec.decode_value(dynamic, tuple_wire)
    tuple_value.child_at(0).type.should eq(types[:tuple_qbit])
    tuple_value.child_at(0).child_at(0).qbit_value.raw_bytes.should eq(Bytes[0x11_u8, 0x22, 0x33])
    CrystalClick::BinaryValueCodec.encode_value(tuple_value).should eq(tuple_wire)

    map_wire = Bytes[
      0x27_u8, 0x15, 0x36, 0x07, 0x03, 0x01, 0x01, 0x6b, 0x03, 0x11, 0x22, 0x33,
    ]
    map_value = CrystalClick::BinaryValueCodec.decode_value(dynamic, map_wire)
    map_value.child_at(0).type.should eq(types[:map_string_qbit])
    map_value.child_at(0).child_at(1).qbit_value.raw_bytes.should eq(Bytes[0x11_u8, 0x22, 0x33])
    CrystalClick::BinaryValueCodec.encode_value(map_value).should eq(map_wire)

    nested_wire = Bytes[
      0x2f_u8, 0x01, 0x01, 0x71, 0x36, 0x07, 0x03, 0x01, 0x03, 0x11, 0x22, 0x33,
    ]
    nested_value = CrystalClick::BinaryValueCodec.decode_value(dynamic, nested_wire)
    nested_value.child_at(0).type.should eq(types[:nested_qbit])
    nested_value.child_at(0).element_at(0).child_at(0).qbit_value.raw_bytes.should eq(Bytes[0x11_u8, 0x22, 0x33])
    CrystalClick::BinaryValueCodec.encode_value(nested_value).should eq(nested_wire)

    # Nullable(Tuple(QBit)) remains eligible only below an ordinary wrapper;
    # both present and NULL child states retain the same independent descriptor.
    nullable_array_wire = Bytes[
      0x1e_u8, 0x23, 0x1f, 0x01, 0x36, 0x07, 0x03, 0x01, 0x00, 0x03, 0x11, 0x22, 0x33,
    ]
    nullable_array = CrystalClick::BinaryValueCodec.decode_value(dynamic, nullable_array_wire)
    nullable_array.child_at(0).type.should eq(types[:array_nullable_tuple_qbit])
    nullable_array.child_at(0).element_at(0).child_at(0).child_at(0).qbit_value.raw_bytes.should eq(
      Bytes[0x11_u8, 0x22, 0x33],
    )
    CrystalClick::BinaryValueCodec.encode_value(nullable_array).should eq(nullable_array_wire)
    nullable_null_wire = Bytes[0x1e_u8, 0x23, 0x1f, 0x01, 0x36, 0x07, 0x03, 0x01, 0x01]
    nullable_null = CrystalClick::BinaryValueCodec.decode_value(dynamic, nullable_null_wire)
    nullable_null.child_at(0).element_at(0).is_null?.should be_true
    CrystalClick::BinaryValueCodec.encode_value(nullable_null).should eq(nullable_null_wire)

    # Variant is legal here only behind Array; its selected QBit and NULL
    # discriminator use the existing leaf and Variant value visitors.
    variant_array_wire = Bytes[
      0x1e_u8, 0x2a, 0x02, 0x36, 0x07, 0x03, 0x01, 0x02, 0x00, 0x03, 0x11, 0x22, 0x33, 0xff,
    ]
    variant_array = CrystalClick::BinaryValueCodec.decode_value(dynamic, variant_array_wire)
    variant_array.child_at(0).type.should eq(types[:array_variant])
    variant_array.child_at(0).element_at(0).child_at(0).qbit_value.raw_bytes.should eq(Bytes[0x11_u8, 0x22, 0x33])
    variant_array.child_at(0).element_at(1).is_null?.should be_true
    CrystalClick::BinaryValueCodec.encode_value(variant_array).should eq(variant_array_wire)

    dynamic_null = CrystalClick::BinaryValueCodec.decode_value(dynamic, Bytes[0x00_u8])
    dynamic_null.is_null?.should be_true
    CrystalClick::BinaryValueCodec.encode_value(dynamic_null).should eq(Bytes[0x00_u8])
  end

  it "counts the same recursive QBit leaves as role generation and retains exact no-QBit plan budgets" do
    types = w233_kernel_types
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 8)
    actual_types = [
      types[:array_qbit],
      types[:tuple_qbit],
      types[:map_string_qbit],
      types[:nested_qbit],
      types[:array_nullable_tuple_qbit],
      types[:array_variant],
      types[:qbit],
      types[:uint8],
    ] of CrystalClick::BinaryDataType
    structure = CrystalClick::DynamicStructure.new(actual_types)
    structures = {"root" => structure}

    defaults = CrystalClick::BinaryCodecLimits.default
    measured = CrystalClick::BinaryCodecBudget.new(defaults, true)
    plan = CrystalClick::BinaryDynamicBulkPlan.new_with_budget(dynamic, structures, measured)

    expected_leaf_paths = [
      w233_arm_path(structure, types[:array_qbit]) + ".elements",
      w233_arm_path(structure, types[:tuple_qbit]) + ".field.0",
      w233_arm_path(structure, types[:map_string_qbit]) + ".elements.field.1",
      w233_arm_path(structure, types[:nested_qbit]) + ".elements.field.0",
      w233_arm_path(structure, types[:array_nullable_tuple_qbit]) + ".elements.nested.field.0",
      w233_arm_path(structure, types[:array_variant]) + ".elements.arm.0",
      w233_arm_path(structure, types[:qbit]),
    ] of String
    sites = plan.qbit_sites
    sites.size.should eq(expected_leaf_paths.size)
    sites.map(&.path).sort.should eq(expected_leaf_paths.sort)
    sites.each do |site|
      site.qbit_type.plane_count.should eq(8)
      site.plane_roles.size.should eq(8)
      site.plane_roles.each_with_index do |role, plane|
        plan.data_roles.should contain(role)
        role.should eq("#{site.path}.qbit_plane.#{plane}")
      end
    end
    plan.data_roles.should contain(w233_arm_path(structure, types[:array_qbit]) + ".sizes")
    plan.data_roles.should contain(w233_arm_path(structure, types[:map_string_qbit]) + ".sizes")
    plan.data_roles.should contain(w233_arm_path(structure, types[:array_variant]) + ".elements.discriminators")
    plan.data_roles.should contain(w233_arm_path(structure, types[:array_nullable_tuple_qbit]) + ".sizes")

    # The retained site paths and numeric plane-role snapshots are charged
    # before allocation: exact measured limits succeed and one byte less fails.
    exact_limits = CrystalClick::BinaryCodecLimits.new(
      max_depth: defaults.max_depth,
      max_nodes: measured.node_count,
      max_elements: measured.element_count,
      max_bytes: measured.wire_byte_count,
    )
    exact_budget = CrystalClick::BinaryCodecBudget.new(exact_limits, true)
    exact_plan = CrystalClick::BinaryDynamicBulkPlan.new_with_budget(dynamic, structures, exact_budget)
    exact_plan.qbit_sites.map(&.path).sort.should eq(expected_leaf_paths.sort)
    {exact_budget.node_count, exact_budget.element_count, exact_budget.wire_byte_count}.should eq(
      {measured.node_count, measured.element_count, measured.wire_byte_count},
    )

    short_limits = CrystalClick::BinaryCodecLimits.new(
      max_depth: defaults.max_depth,
      max_nodes: measured.node_count,
      max_elements: measured.element_count,
      max_bytes: measured.wire_byte_count - 1,
    )
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new_with_budget(
        dynamic,
        structures,
        CrystalClick::BinaryCodecBudget.new(short_limits, true),
      )
    end

    # Freeze the W232 no-QBit plan budget independently of this post-change
    # exact-limit round-trip: Dynamic(max_types=8) with one UInt8 arm under the
    # single-stream/default write profile measured 14 nodes, 13 edges, 734 bytes.
    plain_structure = CrystalClick::DynamicStructure.new([types[:uint8]] of CrystalClick::BinaryDataType)
    plain_structures = {"root" => plain_structure}
    plain_measured = CrystalClick::BinaryCodecBudget.new(defaults, true)
    CrystalClick::BinaryDynamicBulkPlan.new_with_budget(dynamic, plain_structures, plain_measured)
    {plain_measured.node_count, plain_measured.element_count, plain_measured.wire_byte_count}.should eq(
      {14_i64, 13_i64, 734_i64},
    )
    plain_exact_limits = CrystalClick::BinaryCodecLimits.new(
      max_depth: defaults.max_depth,
      max_nodes: plain_measured.node_count,
      max_elements: plain_measured.element_count,
      max_bytes: plain_measured.wire_byte_count,
    )
    plain_exact = CrystalClick::BinaryCodecBudget.new(plain_exact_limits, true)
    CrystalClick::BinaryDynamicBulkPlan.new_with_budget(dynamic, plain_structures, plain_exact)
    {plain_exact.node_count, plain_exact.element_count, plain_exact.wire_byte_count}.should eq(
      {plain_measured.node_count, plain_measured.element_count, plain_measured.wire_byte_count},
    )
  end

  it "round-trips product actuals in the existing Dynamic bulk lanes, including empty and NULL states" do
    types = w233_kernel_types
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 8)
    qbit_value = w233_qbit_value(types[:qbit_type])
    uint8_value = CrystalClick::BinaryValue.fixed(types[:uint8], Bytes[0x07_u8])

    array_one = CrystalClick::BinaryValue.array(types[:array_qbit], [qbit_value] of CrystalClick::BinaryValue)
    array_empty = CrystalClick::BinaryValue.array(types[:array_qbit], [] of CrystalClick::BinaryValue)
    tuple_value = CrystalClick::BinaryValue.tuple(
      types[:tuple_qbit], [qbit_value, uint8_value] of CrystalClick::BinaryValue,
    )
    map_value = CrystalClick::BinaryValue.map(
      types[:map_string_qbit],
      [CrystalClick::BinaryValue.string("k"), qbit_value] of CrystalClick::BinaryValue,
    )
    nested_tuple_type = CrystalClick::BinaryNestedType.tuple_for(types[:nested_qbit])
    nested_tuple = CrystalClick::BinaryValue.tuple(nested_tuple_type, [qbit_value] of CrystalClick::BinaryValue)
    nested_value = CrystalClick::BinaryValue.nested(types[:nested_qbit], [nested_tuple] of CrystalClick::BinaryValue)
    nullable_tuple_type = types[:nullable_tuple_qbit].child_at(0)
    nullable_tuple = CrystalClick::BinaryValue.tuple(nullable_tuple_type, [qbit_value] of CrystalClick::BinaryValue)
    nullable_present = CrystalClick::BinaryValue.nullable(types[:nullable_tuple_qbit], nullable_tuple)
    nullable_null = CrystalClick::BinaryValue.nullable(types[:nullable_tuple_qbit])
    qbit_variant_index = types[:inner_variant].children.index(types[:qbit]).not_nil!
    uint8_variant_index = types[:inner_variant].children.index(types[:uint8]).not_nil!
    variant_qbit = CrystalClick::BinaryValue.variant(types[:inner_variant], qbit_variant_index, qbit_value)
    variant_uint8 = CrystalClick::BinaryValue.variant(types[:inner_variant], uint8_variant_index, uint8_value)
    variant_null = CrystalClick::BinaryValue.variant_null(types[:inner_variant])
    variant_array = CrystalClick::BinaryValue.array(
      types[:array_variant],
      [variant_qbit, variant_uint8, variant_null] of CrystalClick::BinaryValue,
    )

    actual_values = [
      CrystalClick::BinaryValue.dynamic(dynamic, array_one),
      CrystalClick::BinaryValue.dynamic(dynamic, array_empty),
      CrystalClick::BinaryValue.dynamic(dynamic, tuple_value),
      CrystalClick::BinaryValue.dynamic(dynamic, map_value),
      CrystalClick::BinaryValue.dynamic(dynamic, nested_value),
      CrystalClick::BinaryValue.dynamic(dynamic, CrystalClick::BinaryValue.array(
        types[:array_nullable_tuple_qbit], [nullable_present, nullable_null] of CrystalClick::BinaryValue,
      )),
      CrystalClick::BinaryValue.dynamic(dynamic, variant_array),
      CrystalClick::BinaryValue.dynamic(dynamic, qbit_value),
      CrystalClick::BinaryValue.dynamic(dynamic, uint8_value),
      CrystalClick::BinaryValue.dynamic(dynamic),
    ] of CrystalClick::BinaryValue
    rows = [actual_values] of Array(CrystalClick::BinaryValue)
    structures = {
      "root" => CrystalClick::DynamicStructure.new([
        types[:array_qbit],
        types[:tuple_qbit],
        types[:map_string_qbit],
        types[:nested_qbit],
        types[:array_nullable_tuple_qbit],
        types[:array_variant],
        types[:qbit],
        types[:uint8],
      ] of CrystalClick::BinaryDataType),
    }

    streams = CrystalClick::BinaryDynamicBulkCodec.encode(dynamic, structures, rows)
    plan = CrystalClick::BinaryDynamicBulkPlan.new(dynamic, structures)
    plan.qbit_sites.size.should eq(7)
    streams.data.roles.should contain("root.discriminators")
    decoded = CrystalClick::BinaryDynamicBulkCodec.decode(dynamic, streams, [actual_values.size.to_u64])
    w233_dynamic_envelopes(decoded).should eq(w233_dynamic_envelopes(rows))
  end

  it "uses explicit recursive-QBit policies for Dynamic shared overflow and Object Copy" do
    types = w233_kernel_types
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 8)
    qbit_value = w233_qbit_value(types[:qbit_type])
    actual = CrystalClick::BinaryValue.array(types[:array_qbit], [qbit_value] of CrystalClick::BinaryValue)
    dynamic_value = CrystalClick::BinaryValue.dynamic(dynamic, actual)
    rows = [[dynamic_value]] of Array(CrystalClick::BinaryValue)
    structure = CrystalClick::DynamicStructure.new([types[:uint8]] of CrystalClick::BinaryDataType)
    structures = {"root" => structure}

    # The product is intentionally absent from the exact actual roster, so it
    # must take the qualified Dynamic shared-child envelope path. Dynamic
    # explicitly opts into the shared scalar helper here; Object Shared Copy
    # has its own non-Variant owner policy, while direct helper calls retain
    # the default denial.
    plan = CrystalClick::BinaryDynamicBulkPlan.new(dynamic, structures)
    selection = plan.select_arm("root", types[:array_qbit])
    selection.shared.should be_true
    selection.index.should eq(structure.shared_index.to_u8)
    plan.qbit_sites.should be_empty

    streams = CrystalClick::BinaryDynamicBulkCodec.encode(dynamic, structures, rows)
    shared_data_role = "root.arm.#{selection.index}.data"
    streams.data.roles.should contain(shared_data_role)
    decoded = CrystalClick::BinaryDynamicBulkCodec.decode(dynamic, streams, [1_u64])
    w233_dynamic_envelopes(decoded).should eq(w233_dynamic_envelopes(rows))
  end

  it "keeps Dynamic root and foreign-owner guards while admitting qualified Object Copy products" do
    types = w233_kernel_types
    dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 8)
    qbit_value = w233_qbit_value(types[:qbit_type])

    # Direct QBit remains supported; direct Variant, Dynamic, and Nullable
    # actual types remain rejected by the Dynamic V3 roster law.
    CrystalClick::BinaryValue.dynamic(dynamic, qbit_value).child_at(0).type.should eq(types[:qbit])
    qbit_variant = CrystalClick::BinaryValue.variant(
      types[:inner_variant],
      types[:inner_variant].children.index(types[:qbit]).not_nil!,
      qbit_value,
    )
    expect_raises(ArgumentError) do
      CrystalClick::BinaryValue.dynamic(dynamic, qbit_variant)
    end
    expect_raises(ArgumentError) do
      CrystalClick::DynamicStructure.new([types[:inner_variant]] of CrystalClick::BinaryDataType)
    end
    expect_raises(ArgumentError) do
      CrystalClick::DynamicStructure.new([types[:nullable_tuple_qbit]] of CrystalClick::BinaryDataType)
    end
    expect_raises(ArgumentError) do
      CrystalClick::DynamicStructure.new([dynamic] of CrystalClick::BinaryDataType)
    end
    expect_raises(ArgumentError) do
      CrystalClick::BinaryDataType.low_cardinality(types[:qbit])
    end

    # The root-sensitive gate is repeated at both Dynamic shared-child
    # boundaries. These bytes independently describe Variant(QBit, UInt8)
    # with its QBit arm selected; a recursive-QBit opt-in may admit products,
    # but must not turn the source-invalid direct Variant into an actual.
    qbit_variant_actual_wire = Bytes[
      0x2a_u8, 0x02_u8, 0x36, 0x07, 0x03, 0x01, 0x00, 0x03, 0x11, 0x22, 0x33,
    ]
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.encode_dynamic_bulk_child(
        qbit_variant,
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default, true),
        1,
        allow_recursive_qbit: true,
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.decode_dynamic_bulk_child(
        qbit_variant_actual_wire,
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default),
        1,
        allow_recursive_qbit: true,
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.decode(
        Bytes[
          0x2b_u8, 0x08_u8, 0x2a, 0x02, 0x36, 0x07, 0x03, 0x01, 0x00, 0x03, 0x11, 0x22, 0x33,
        ],
      )
    end

    direct_nullable = CrystalClick::BinaryValue.nullable(types[:nullable_tuple_qbit], CrystalClick::BinaryValue.tuple(
      types[:nullable_tuple_qbit].child_at(0), [qbit_value] of CrystalClick::BinaryValue,
    ))
    direct_nullable_actual_wire = Bytes[
      0x23_u8, 0x1f, 0x01, 0x36, 0x07, 0x03, 0x00, 0x03, 0x11, 0x22, 0x33,
    ]
    expect_raises(ArgumentError) do
      CrystalClick::BinaryValue.dynamic(dynamic, direct_nullable)
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.encode_dynamic_bulk_child(
        direct_nullable,
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default, true),
        1,
        allow_recursive_qbit: true,
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.decode_dynamic_bulk_child(
        direct_nullable_actual_wire,
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default),
        1,
        allow_recursive_qbit: true,
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.decode(
        Bytes[
          0x2b_u8, 0x08_u8, 0x23, 0x1f, 0x01, 0x36, 0x07, 0x03, 0x00, 0x03, 0x11, 0x22, 0x33,
        ],
      )
    end

    # A recursive QBit predicate may not ignore a different runtime-owned
    # sibling and thereby qualify the whole tuple as a static Dynamic actual.
    nested_dynamic = CrystalClick::BinaryDataType.dynamic(max_types: 0)
    mixed_dynamic = CrystalClick::BinaryDataType.tuple(
      [types[:qbit], nested_dynamic] of CrystalClick::BinaryDataType,
    )
    mixed_dynamic_value = CrystalClick::BinaryValue.tuple(
      mixed_dynamic,
      [qbit_value, CrystalClick::BinaryValue.dynamic(nested_dynamic)] of CrystalClick::BinaryValue,
    )
    expect_raises(ArgumentError) do
      CrystalClick::BinaryValue.dynamic(dynamic, mixed_dynamic_value)
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new(
        dynamic,
        {"root" => CrystalClick::DynamicStructure.new([mixed_dynamic] of CrystalClick::BinaryDataType)},
      )
    end

    low = CrystalClick::BinaryDataType.low_cardinality(types[:uint8])
    mixed_low = CrystalClick::BinaryDataType.tuple([types[:qbit], low] of CrystalClick::BinaryDataType)
    mixed_low_value = CrystalClick::BinaryValue.tuple(
      mixed_low,
      [
        qbit_value,
        CrystalClick::BinaryValue.low_cardinality(low, CrystalClick::BinaryValue.fixed(types[:uint8], Bytes[0x07_u8])),
      ] of CrystalClick::BinaryValue,
    )
    expect_raises(ArgumentError) do
      CrystalClick::BinaryValue.dynamic(dynamic, mixed_low_value)
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new(
        dynamic,
        {"root" => CrystalClick::DynamicStructure.new([mixed_low] of CrystalClick::BinaryDataType)},
      )
    end

    aggregate = CrystalClick::BinaryDataType.aggregate_function("sum", types[:uint8])
    mixed_aggregate = CrystalClick::BinaryDataType.tuple(
      [types[:qbit], aggregate] of CrystalClick::BinaryDataType,
    )
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new(
        dynamic,
        {"root" => CrystalClick::DynamicStructure.new([mixed_aggregate] of CrystalClick::BinaryDataType)},
      )
    end

    uint64 = CrystalClick::BinaryDataType.primitive("UInt64")
    simple_aggregate = CrystalClick::BinaryDataType.simple_aggregate(
      CrystalClick::BinarySimpleAggregateType::Function::Sum,
      uint64,
    )
    mixed_simple_aggregate = CrystalClick::BinaryDataType.tuple(
      [types[:qbit], simple_aggregate] of CrystalClick::BinaryDataType,
    )
    expect_raises(ArgumentError) do
      CrystalClick::BinaryValue.dynamic(
        dynamic,
        CrystalClick::BinaryValue.tuple(
          mixed_simple_aggregate,
          [qbit_value, CrystalClick::BinaryValue.simple_aggregate(
            simple_aggregate,
            CrystalClick::BinaryValue.fixed(uint64, Bytes[0x07_u8, 0, 0, 0, 0, 0, 0, 0]),
          )] of CrystalClick::BinaryValue,
        ),
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new(
        dynamic,
        {"root" => CrystalClick::DynamicStructure.new([mixed_simple_aggregate] of CrystalClick::BinaryDataType)},
      )
    end

    json = CrystalClick::BinaryDataType.json
    mixed_json = CrystalClick::BinaryDataType.tuple([types[:qbit], json] of CrystalClick::BinaryDataType)
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryDynamicBulkPlan.new(
        dynamic,
        {"root" => CrystalClick::DynamicStructure.new([mixed_json] of CrystalClick::BinaryDataType)},
      )
    end

    # Object Shared Copy has a separate qualified non-Variant opt-in. The
    # shared scalar helper must remain closed by default for recursive QBit.
    object_path = "payload"
    object_value = CrystalClick::BinaryValue.array(types[:array_qbit], [] of CrystalClick::BinaryValue)
    object_row = CrystalClick::ObjectSharedMapRow.new([
      CrystalClick::ObjectSharedMapEntry.new(object_path.to_slice, object_value),
    ] of CrystalClick::ObjectSharedMapEntry)
    object_structure = CrystalClick::ObjectSharedChunkStructure.new(
      1_u64,
      [object_path] of String,
      {0_u64, 0_u64},
      {0_u64, 0_u64},
      {0_u64, 0_u64},
    )
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.encode_dynamic_bulk_child(
        object_value,
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default, true),
        1,
      )
    end
    expect_raises(CrystalClick::UnsupportedFormatError) do
      CrystalClick::BinaryValueCodec.decode_dynamic_bulk_child(
        Bytes[0x1e_u8, 0x36, 0x07, 0x03, 0x00],
        CrystalClick::BinaryCodecBudget.new(CrystalClick::BinaryCodecLimits.default),
        1,
      )
    end

    encoded_copy = CrystalClick::ObjectSharedCopyCodec.encode(
      [object_row] of CrystalClick::ObjectSharedMapRow,
      [object_structure] of CrystalClick::ObjectSharedChunkStructure,
    )
    decoded_copy = CrystalClick::ObjectSharedCopyCodec.decode(
      encoded_copy.sizes,
      encoded_copy.indexes,
      encoded_copy.values,
      [object_structure] of CrystalClick::ObjectSharedChunkStructure,
    )
    decoded_copy.size.should eq(1)
    decoded_copy[0].entry_count.should eq(1)
    decoded_copy[0].entry_at(0).path.should eq(object_path.to_slice)
    decoded_value = decoded_copy[0].entry_at(0).value
    decoded_value.type.should eq(types[:array_qbit])
    decoded_value.element_count.should eq(0)
    reencoded_copy = CrystalClick::ObjectSharedCopyCodec.encode(
      decoded_copy,
      [object_structure] of CrystalClick::ObjectSharedChunkStructure,
    )
    reencoded_copy.sizes.should eq(encoded_copy.sizes)
    reencoded_copy.indexes.should eq(encoded_copy.indexes)
    reencoded_copy.values.should eq(encoded_copy.values)
  end
end
