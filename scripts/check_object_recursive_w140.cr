  private def fail(message : String) : NoReturn
    raise Mismatch.new(message)
  end

  private def assert(condition : Bool, message : String) : Nil
    fail(message) unless condition
  end

  private def expect_mismatch(label : String, &)
    begin
      yield
    rescue error : Mismatch
      puts "PASS W140 seeded comparator failure: #{label}"
      return
    end
    fail("#{label}: seeded mismatch passed the oracle comparator")
  end

  private def process_env : Hash(String, String)
    environment = ENV.to_h
    environment["TZ"] = "UTC"
    environment
  end

  private def run_status(binary : String, arguments : Array(String)) : String
    output = IO::Memory.new
    error = IO::Memory.new
    status = Process.run(binary, arguments, env: process_env, output: output, error: error)
    raise "command failed: #{error}" unless status.success?
    output.to_s
  end

  private def execute(
    binary : String, store : String, query : String, evidence_prefix : String, input : IO? = nil,
  ) : String
    output = IO::Memory.new
    error = IO::Memory.new
    arguments = ["local", "--path", store, "--session_timezone=UTC", "--enable_time_time64_type=1",
                 "--print_pretty_type_names=0", "--query", query]
    status = if input
               Process.run(binary, arguments, env: process_env, input: input, output: output, error: error)
             else
               Process.run(binary, arguments, env: process_env, output: output, error: error)
             end
    File.write("#{evidence_prefix}.stdout", output.to_s)
    File.write("#{evidence_prefix}.stderr", error.to_s)
    raise "ClickHouse local query failed (#{evidence_prefix}): #{error}\n#{query}" unless status.success?
    output.to_s
  end

  private def assert_safe_root(root : String) : String
    assert(Dir.exists?(root) && !File.symlink?(root), "W140 paired root must be an existing non-symlink directory")
    real = File.realpath(root)
    parent = File.dirname(real)
    leaf = File.basename(real)
    direct_root = parent == "/private/tmp" && leaf.starts_with?("crystal-click-object-recursive-w140.")
    nested_root = leaf == "paired" && File.dirname(parent) == "/private/tmp" &&
                  File.basename(parent).starts_with?("crystal-click-object-recursive-w140.")
    assert(direct_root || nested_root, "W140 paired root is outside its allowed temporary namespace: #{real}")
    assert(!File.exists?(File.join(real, "stores")) && !File.exists?(File.join(real, "results")) &&
           !File.exists?(File.join(real, "manifest.json")), "W140 paired evidence root is not fresh")
    real
  end

  private def verify_runtime(binary : String, store : String, evidence : String) : Nil
    digest = run_status("shasum", ["-a", "256", binary]).split(' ').first? || ""
    assert(digest == EXECUTABLE_SHA256, "unexpected ClickHouse executable SHA-256: #{digest}")
    version = run_status(binary, ["local", "--version"]).strip
    assert(version == "ClickHouse local version #{VERSION} (official build).", "unexpected ClickHouse version: #{version.inspect}")
    identity = execute(binary, store,
      "SELECT concat(name, '=', value) FROM system.build_options WHERE name IN ('GIT_HASH','VERSION_GITHASH') ORDER BY name FORMAT TSVRaw",
      "#{evidence}/build-identity")
    expected_identity = "GIT_HASH=#{BUILD_HASH}\nVERSION_GITHASH=#{BUILD_HASH}\n"
    assert(identity == expected_identity, "unexpected ClickHouse build identity: #{identity.inspect}")
    timezone = execute(binary, store,
      "SELECT timezone(), timezoneOf(toDateTime('2020-01-02 03:04:05')) FORMAT TSVRaw", "#{evidence}/timezone")
    assert(timezone.strip == "UTC\tUTC", "ClickHouse process/session timezone is not UTC: #{timezone.inspect}")
    puts "W140 pinned runtime: #{version}; sha256=#{digest}; build=#{BUILD_HASH}; TZ/session UTC; Time enabled"
  end

  private def type_roster : Array(Field)
    enum_type = DataType.enum8([{"off", 0_i16}, {"on", 1_i16}] of CrystalClick::BinaryEnumDefinition::Entry)
    timestamp = DataType.datetime64(3, "UTC")
    event = DataType.tuple([enum_type, timestamp] of DataType, ["state", "at"] of String)
    nullable_event = DataType.nullable(event)
    u16 = DataType.primitive("UInt16")
    string = DataType.primitive("String")
    map_u16 = DataType.map(string, u16)
    named_tuple = DataType.tuple([u16, string] of DataType, ["n", "s"] of String)
    unnamed_tuple = DataType.tuple([u16, string] of DataType)
    nullable_tuple = DataType.nullable(named_tuple)
    tuple_array_map = DataType.tuple([DataType.array(u16), map_u16] of DataType, ["a", "m"] of String)

    [
      Field.new("arr_map_u16", "Array(Map(String, UInt16))", DataType.array(map_u16)),
      Field.new("arr_nullable_event", "Array(Nullable(Tuple(state Enum8('off' = 0, 'on' = 1), at DateTime64(3, 'UTC'))))", DataType.array(nullable_event)),
      Field.new("arr_nullable_u16", "Array(Nullable(UInt16))", DataType.array(DataType.nullable(u16))),
      Field.new("arr_u16", "Array(UInt16)", DataType.array(u16)),
      Field.new("events", "Array(Tuple(state Enum8('off' = 0, 'on' = 1), at DateTime64(3, 'UTC')))", DataType.array(event)),
      Field.new("map_tuple", "Map(String, Tuple(n UInt16, s String))", DataType.map(string, named_tuple)),
      Field.new("map_u16", "Map(String, UInt16)", map_u16),
      Field.new("nullable_tuple", "Nullable(Tuple(n UInt16, s String))", nullable_tuple),
      Field.new("t", "String", string),
      Field.new("tuple_array_map", "Tuple(a Array(UInt16), m Map(String, UInt16))", tuple_array_map),
      Field.new("tuple_empty", "Tuple()", DataType.tuple([] of DataType)),
      Field.new("tuple_named", "Tuple(n UInt16, s String)", named_tuple),
      Field.new("tuple_unnamed", "Tuple(UInt16, String)", unnamed_tuple),
    ]
  end

  private def typed_schema(fields : Array(Field)) : Hash(String, DataType)
    result = {} of String => DataType
    fields.each { |field| result[field.name] = field.type }
    result
  end

  private def expected_declaration(fields : Array(Field)) : String
    "JSON(max_dynamic_types=1, max_dynamic_paths=1, #{fields.map { |field| "#{field.name} #{field.type_name}" }.join(", ")})"
  end

  private def checked_schema(fields : Array(Field)) : CrystalClick::ObjectDocumentSchema
    declaration = expected_declaration(fields)
    parsed = CrystalClick::ObjectDocumentSchema.parse_declaration(declaration)
    assert(parsed.declaration == declaration, "recursive declaration differs from the literal canonical roster")
    assert(parsed.typed_paths == typed_schema(fields), "recursive parser changed a nominal field identity")
    assert(parsed.typed_paths.keys.sort == fields.map(&.name).sort, "recursive parser changed declaration field inventory")
    parsed
  end

