  # This is an independent RowBinary fixture encoder, not a library codec.
  # It follows the stock binary grammar for exactly the declared test nodes:
  # VarUInt container/string lengths, little-endian leaves, nullable flag,
  # and ordered tuple children. RowBinary empty Tuple rows have no bytes;
  # Wide-part bulk SerializationTuple separately uses an ASCII '0' token.
  private def encode_rowbinary(io : IO, json : JSON::Any, type : DataType) : Nil
    case type.tag
    when DataType::TAG_ARRAY
      entries = json.as_a
      var_uint(io, entries.size.to_u64)
      entries.each { |entry| encode_rowbinary(io, entry, type.child_at(0)) }
    when DataType::TAG_MAP
      entries = json.as_h
      var_uint(io, entries.size.to_u64)
      entries.each do |key, child|
        encode_rowbinary(io, JSON::Any.new(key), type.child_at(0))
        encode_rowbinary(io, child, type.child_at(1))
      end
    when DataType::TAG_UNNAMED_TUPLE, DataType::TAG_NAMED_TUPLE
      unless type.child_count == 0
        entries = json.as_a
        assert(entries.size == type.child_count, "RowBinary fixture tuple arity differs")
        entries.each_with_index { |entry, i| encode_rowbinary(io, entry, type.child_at(i)) }
      end
    when DataType::TAG_NULLABLE
      if json.raw.nil?
        io.write_byte(1_u8)
      else
        io.write_byte(0_u8)
        encode_rowbinary(io, json, type.child_at(0))
      end
    when DataType::TAG_STRING
      bytes = json.as_s.to_slice
      var_uint(io, bytes.size.to_u64)
      io.write(bytes)
    when DataType::TAG_UINT8, DataType::TAG_UINT16
      io.write(uint_bytes(json.as_i.to_u64, type.fixed_width.not_nil!))
    when DataType::TAG_ENUM8
      io.write_byte(json.as_s == "off" ? 0_u8 : 1_u8)
    when DataType::TAG_DATETIME64_ZONE, DataType::TAG_DATETIME64
      assert(json.as_s == EVENT_AT, "RowBinary timestamp differs from literal witness")
      io.write(bytes_from_hex(EVENT_AT_HEX))
    else
      fail("RowBinary fixture encoder has no literal mapping for type tag #{type.tag}")
    end
    nil
  end

  private def expected_rowbinary(indices : Array(Int32), fields : Array(Field)) : String
    String.build do |io|
      indices.each do |index|
        payload = json_payload(index).as_h
        fields.each do |field|
          json = if field.name == "tuple_empty" && !payload.has_key?(field.name)
                   JSON.parse("[]")
                 else
                   payload[field.name]? || raise Mismatch.new("RowBinary fixture lacks #{field.name}")
                 end
          encode_rowbinary(io, json, field.type)
        end
      end
    end
  end

  private def assert_rowbinary(actual : String, indices : Array(Int32), fields : Array(Field), label : String) : Nil
    expected = expected_rowbinary(indices, fields)
    assert(actual.to_slice == expected.to_slice, "#{label}: stock RowBinary bytes differ from independent literal grammar")
  end

  private def assert_value(expected : Value, actual : Value, label : String) : Nil
    assert(expected.type == actual.type, "#{label}: nominal type identity differs")
    assert(expected.is_null? == actual.is_null?, "#{label}: nullable state differs")
    return if expected.is_null?
    if expected.type.tag == DataType::TAG_ARRAY || expected.type.tag == DataType::TAG_MAP ||
       expected.type.tag == DataType::TAG_UNNAMED_TUPLE || expected.type.tag == DataType::TAG_NAMED_TUPLE ||
       expected.type.tag == DataType::TAG_NULLABLE
      assert(expected.element_count == actual.element_count, "#{label}: child count differs")
      expected.element_count.times { |index| assert_value(expected.element_at(index), actual.element_at(index), "#{label}[#{index}]") }
    else
      assert(expected.bytes == actual.bytes, "#{label}: exact carrier bytes differ")
    end
  end

  private def assert_documents(expected : Array(Document), actual : Array(Document), label : String) : Nil
    assert(expected.size == actual.size, "#{label}: row count differs")
    expected.each_with_index do |document, index|
      found = actual[index]
      assert(document.paths == found.paths, "#{label}: path roster differs at row #{index}")
      document.paths.each { |path| assert_value(document.value_for(path), found.value_for(path), "#{label} row #{index} #{path}") }
    end
  end

  private def assert_granules(expected : Array(Array(Document)), actual : Array(Array(Document)), label : String) : Nil
    assert(expected.size == actual.size, "#{label}: mark count differs")
    expected.each_with_index { |rows, mark| assert_documents(rows, actual[mark], "#{label} mark #{mark}") }
  end

  private def assert_grid(actual : Array(UInt64), label : String) : Nil
    assert(actual == ROWS_PER_MARK, "#{label}: expected mark rows #{ROWS_PER_MARK.inspect}, got #{actual.inspect}")
  end

  private def write_manifest(root : String, fields : Array(Field)) : Nil
    File.open(File.join(root, "manifest.json"), "w") do |file|
      JSON.build(file) do |json|
        json.object do
          json.field "oracle", "W140 paired recursive Object interoperability"
          json.field "runtime_version", VERSION
          json.field "runtime_sha256", EXECUTABLE_SHA256
          json.field "runtime_build_hash", BUILD_HASH
          json.field "timezone", "TZ=UTC; session_timezone=UTC; enable_time_time64_type=1"
          json.field "row_count", KEYS.size
          json.field "rows_per_mark", ROWS_PER_MARK
          json.field "string_profiles", PROFILES.map(&.first)
          json.field "dynamic_discriminator_modes", MODES.map(&.first)
          json.field "object_layout", "V3 / Wide / MAP / one shared bucket; plain .mrk2 and primary.idx"
          json.field "tuple_empty_input", "tuple_empty is absent from all JSONEachRow payloads; stock missing-path default, never explicit []"
          json.field "field_declaration_order" do
            json.array do
              fields.each do |field|
                json.object do
                  json.field "name", field.name
                  json.field "type", field.type_name
                end
              end
            end
          end
          json.field "literal_json_each_row" do
            json.array { FIXTURE_ROWS.each { |row| json.string row } }
          end
          json.field "cells" do
            json.array do
              @manifest_cells.each do |cell|
                json.object do
                  json.field "label", cell.label
                  json.field "state", cell.state
                  json.field "direction", cell.direction
                  json.field "string_profile", cell.profile
                  json.field "dynamic_discriminator_mode", cell.discriminator_mode
                  json.field "store_path", cell.store
                  json.field "table", cell.table
                  json.field "table_data_path", cell.table_data_path
                  json.field "part_name", cell.part_name
                  json.field "part_path", cell.part_path
                  json.field "catalog_root", cell.catalog_root
                  json.field "catalog_part_path", cell.catalog_part_path
                  json.field "expected_full_rowbinary_file", cell.expected_full
                  json.field "actual_full_rowbinary_file", cell.actual_full
                  json.field "expected_middle_rowbinary_file", cell.expected_middle
                  json.field "actual_middle_rowbinary_file", cell.actual_middle
                  json.field "logical_stream_names", cell.stream_names
                  json.field "selected_checksum_names", cell.checksum_names
                end
              end
            end
          end
        end
      end
    end
  end

  private def click(binary : String, store : String, query : String, evidence : String, input : IO? = nil) : String
    execute(binary, store, query, evidence, input)
  end

  private def verify_part_path(path : String, store : String, label : String) : String
    real_store = File.realpath(store)
    real_path = File.realpath(path)
    assert(real_path.starts_with?(real_store + "/") && !File.symlink?(path), "#{label}: part escapes its isolated store")
    cursor = real_store
    relative = real_path[(real_store.size + 1)..]
    relative.split('/').each do |component|
      cursor = File.join(cursor, component)
      assert(!File.symlink?(cursor), "#{label}: symlink in part path")
    end
    real_path
  end

  private def create_table(
    binary : String, store : String, table : String, declaration : String,
    profile : String, mode : UInt64, evidence : String, label : String,
  ) : Nil
    compact = mode == CrystalClick::DynamicDiscriminatorCodec::COMPACT_MODE ? 1 : 0
    settings = "#{SETTINGS_BASE}, use_compact_variant_discriminators_serialization=#{compact}, string_serialization_version='#{profile}'"
    click(binary, store,
      "CREATE TABLE default.#{table} (pk UInt64, payload #{declaration}) ENGINE=MergeTree ORDER BY pk SETTINGS #{settings}",
      "#{evidence}/create")
    columns = click(binary, store,
      "SELECT name || ' ' || type FROM system.columns WHERE database='default' AND table='#{table}' ORDER BY position FORMAT TSVRaw",
      "#{evidence}/columns")
    assert(columns == "pk UInt64\npayload #{declaration}\n", "#{label}: live SQL declaration differs: #{columns.inspect}")
  end

  private def active_parts(binary : String, store : String, table : String, evidence : String) : Array(String)
    click(binary, store,
      "SELECT name, path, part_type, toString(rows) FROM system.parts WHERE database='default' AND table='#{table}' AND active ORDER BY name FORMAT TSVRaw",
      evidence).lines.map(&.chomp)
  end

  private def stock_part(binary : String, store : String, table : String, evidence : String, label : String) : Part
    rows = active_parts(binary, store, table, "#{evidence}/active-parts")
    assert(rows.size == 1, "#{label}: expected exactly one active part, got #{rows.size}")
    fields = rows.first.split('\t')
    assert(fields.size == 4 && fields[2] == "Wide" && fields[3] == KEYS.size.to_s,
      "#{label}: expected a seven-row Wide part, got #{rows.first.inspect}")
    path = verify_part_path(fields[1], store, label)
    assert(File.file?(File.join(path, "checksums.txt")), "#{label}: part lacks checksums.txt")
    Part.new(fields[0], path, KEYS.size.to_u64)
  end

  private def assert_check(binary : String, store : String, table : String, evidence : String, label : String, expected_part : String) : Nil
    active = click(binary, store,
      "SELECT count() FROM system.parts WHERE database='default' AND table='#{table}' AND active FORMAT TSVRaw",
      "#{evidence}/active-count").strip.to_i
    assert(active > 0, "#{label}: cannot qualify an empty active-part set")
    output = click(binary, store, "CHECK TABLE default.#{table} FORMAT TabSeparated", "#{evidence}/check-table")
    lines = output.lines.map(&.chomp)
    assert(lines.size == active, "#{label}: CHECK TABLE row count #{lines.size} differs from active part count #{active}")
    lines.each do |line|
      columns = line.split('\t', remove_empty: false)
      assert(columns[0]? == expected_part, "#{label}: CHECK TABLE returned a different part name")
      assert(columns.size == 3 && !columns[0].empty? && columns[1] == "1" && columns[2].empty?,
        "#{label}: CHECK TABLE row is not exactly part-name / 1 / empty-message: #{line.inspect}")
    end
    nil
  end

  private def assert_type_names(binary : String, store : String, table : String, fields : Array(Field), evidence : String, label : String) : Nil
    projection = fields.map { |field| "toTypeName(payload.#{field.name})" }.join(", ")
    actual = click(binary, store,
      "SELECT #{projection} FROM default.#{table} ORDER BY pk LIMIT 1 FORMAT TSVRaw", evidence).strip
    expected = fields.map(&.type_name).join('\t')
    assert(actual == expected, "#{label}: canonical nominal names differ: #{actual.inspect}")
  end

  private def assert_native_rowbinary(
    binary : String, store : String, table : String, fields : Array(Field), result_dir : String, label : String,
  ) : {String, String}
    projection = fields.map { |field| "payload.#{field.name}" }.join(", ")
    expected_full = expected_rowbinary((0...KEYS.size).to_a, fields)
    expected_middle = expected_rowbinary([2, 3], fields)
    File.write(File.join(result_dir, "expected-full.rowbinary"), expected_full)
    File.write(File.join(result_dir, "expected-middle.rowbinary"), expected_middle)
    full = click(binary, store,
      "SELECT #{projection} FROM default.#{table} ORDER BY pk FORMAT RowBinary", "#{result_dir}/actual-full")
    middle = click(binary, store,
      "SELECT #{projection} FROM default.#{table} WHERE pk >= 3 AND pk <= 4 ORDER BY pk FORMAT RowBinary",
      "#{result_dir}/actual-middle")
    File.write(File.join(result_dir, "actual-full.rowbinary"), full)
    File.write(File.join(result_dir, "actual-middle.rowbinary"), middle)
    assert_rowbinary(full, (0...KEYS.size).to_a, fields, "#{label} full RowBinary")
    assert_rowbinary(middle, [2, 3], fields, "#{label} selected RowBinary")
    {full, middle}
  end

  private def read_u64_le(bytes : Bytes, offset : Int32) : UInt64
    assert(offset >= 0 && offset <= bytes.size - 8, "Dynamic discriminator header is truncated")
    value = 0_u64
    8.times { |index| value |= bytes[offset + index].to_u64 << (index * 8) }
    value
  end

  private def assert_reader(
    part : Part, schema : CrystalClick::ObjectDocumentSchema, fields : Array(Field),
    docs : Array(Document), expected_profile : CrystalClick::BinaryBulkProfile,
    expected_mode : UInt64, label : String,
  ) : {Array(String), Array(String)}
    reader = CrystalClick::ObjectColumnReader.open(part.path, "payload", schema)
    assert(reader.row_count == KEYS.size.to_u64, "#{label}: Object reader row count differs")
    assert(reader.ordinary_profile == expected_profile, "#{label}: actual ordinary String profile differs")
    grid = reader.mark_row_counts
    assert_grid(grid, "#{label} ObjectColumnReader")
    marks = expected_marks(docs)
    assert_granules(marks, reader.read_marks(0, grid.size), "#{label} ObjectColumnReader full")
    assert_granules([marks[1]], reader.read_marks(1, 1), "#{label} ObjectColumnReader middle")
    assert_granules([] of Array(Document), reader.read_marks(grid.size, 0), "#{label} ObjectColumnReader zero")

    profile = reader.ordinary_profile
    full = CrystalClick::ObjectDocumentFileReader.read(
      part.path, "payload", schema.typed_paths, first_mark: 0, mark_count: grid.size,
      profile: profile, shared_profile: CrystalClick::BinaryBulkProfile.single_stream,
      hashed: true, limits: CrystalClick::BinaryCodecLimits.default,
      transport_limits: CrystalClick::CompressedStreamLimits.new
    )
    middle = CrystalClick::ObjectDocumentFileReader.read(
      part.path, "payload", schema.typed_paths, first_mark: 1, mark_count: 1,
      profile: profile, shared_profile: CrystalClick::BinaryBulkProfile.single_stream,
      hashed: true, limits: CrystalClick::BinaryCodecLimits.default,
      transport_limits: CrystalClick::CompressedStreamLimits.new
    )
    zero = CrystalClick::ObjectDocumentFileReader.read(
      part.path, "payload", schema.typed_paths, first_mark: grid.size, mark_count: 0,
      profile: profile, shared_profile: CrystalClick::BinaryBulkProfile.single_stream,
      hashed: true, limits: CrystalClick::BinaryCodecLimits.default,
      transport_limits: CrystalClick::CompressedStreamLimits.new
    )
    assert_granules(marks, full, "#{label} ObjectDocumentFileReader full")
    assert_granules([marks[1]], middle, "#{label} ObjectDocumentFileReader middle")
    assert_granules([] of Array(Document), zero, "#{label} ObjectDocumentFileReader zero")

    physical = CrystalClick::ObjectDocumentPhysicalPlan.new(
      "payload",
      CrystalClick::ObjectDocumentPlan.new(
        CrystalClick::ObjectDynamicStructureSet.new(
          CrystalClick::ObjectStructure.new(["d"] of String),
          {"d" => CrystalClick::DynamicStructure.new([DataType.primitive("Int64")])} of String => CrystalClick::DynamicStructure
        ), schema.typed_paths
      ),
      expected_profile, CrystalClick::BinaryBulkProfile.single_stream
    )
    descriptor = CrystalClick::ObjectDocumentFileReader.inspect(
      part.path, "payload", schema.typed_paths, expected_profile,
      CrystalClick::BinaryBulkProfile.single_stream, true
    )
    object = descriptor.plan.structures.object
    assert(object.version == 4_u64 && object.shared_data_version == 0_u64 && object.bucket_count == 1_u64,
      "#{label}: actual Object layout is not V3 with one MAP shared bucket")
    assert(descriptor.plan.typed_paths == schema.typed_paths && fields.all? { |field| descriptor.plan.typed_type_for(field.name) == field.type },
      "#{label}: recursive nominal type identity differs in the actual part")
    assert(descriptor.plan.structures.dynamic_count == 1 && descriptor.plan.structures.object.dynamic_paths == ["d"],
      "#{label}: actual Dynamic path roster differs")
    assert(descriptor.plan.structures.dynamics["d"].types == [DataType.primitive("Int64")],
      "#{label}: actual Dynamic arm differs from Int64")
    source = CrystalClick::PartStreamSource.new(part.path)
    discriminator_name = CrystalClick::StreamName.hash(physical.discriminator_stream("d")) + ".bin"
    actual_mode = read_u64_le(source.read_all(discriminator_name), 0)
    assert(actual_mode == expected_mode, "#{label}: actual Dynamic discriminator mode differs: #{actual_mode}")
    logical = reader.physical_stream_names
    checksums = reader.selected_checksum_names
    expected_logical = physical.stream_names
    expected_checksums = [] of String
    expected_logical.each do |name|
      hashed = CrystalClick::StreamName.hash(name)
      expected_checksums << "#{hashed}.bin"
      expected_checksums << "#{hashed}.mrk2"
    end
    expected_checksums.sort!
    assert(logical == expected_logical, "#{label}: actual logical stream inventory differs from recursive plan")
    assert(checksums == expected_checksums, "#{label}: selected checksummed filenames differ from hashed plain stream plan")
    checksum_dir = Dir.children(part.path)
    checksums.each do |name|
      assert(checksum_dir.includes?(name) && File.file?(File.join(part.path, name)), "#{label}: selected stream file is missing: #{name}")
    end
    assert(checksum_dir.any?(&.ends_with?(".mrk2")) && checksum_dir.none?(&.ends_with?(".cmrk2")),
      "#{label}: normalized plain .mrk2 inventory is absent or compressed")
    assert(File.file?(File.join(part.path, "primary.idx")) && !File.exists?(File.join(part.path, "primary.cidx")),
      "#{label}: normalized plain primary.idx is absent or compressed")
    checks = CrystalClick::PartChecksums.open(part.path)
    primary = CrystalClick::PrimaryKeyIndex.open(part.path, grid.size, checks, verify_recorded_hash: true)
    assert(primary.keys == [1_u64, 3_u64, 5_u64, 7_u64, 7_u64], "#{label}: primary index keys/sentinel differ")
    assert(primary.candidate_marks(6_u64, 6_u64) == [2_i32], "#{label}: PK=6 candidate mark differs")
    {logical, checksums}
  end

  private def catalog_root(root : String, label : String, table_number : Int32, part : Part, declaration : String) : {String, String}
    catalog = File.join(root, "catalog", label)
    assert(!File.exists?(catalog) && !File.symlink?(File.dirname(catalog)), "#{label}: catalog destination exists or unsafe")
    metadata = File.join(catalog, "metadata")
    FileUtils.mkdir_p(metadata)
    FileUtils.mkdir_p(File.join(catalog, "store"))
    database_uuid = "14000000-0000-4000-8000-000000000001"
    table_uuid = "14010000-0000-4000-8000-00000000000#{table_number}"
    File.write(File.join(metadata, "lab.sql"), "ATTACH DATABASE _ UUID '#{database_uuid}'\nENGINE = Atomic\n")
    database_dir = File.join(catalog, "store", database_uuid[0, 3], database_uuid)
    FileUtils.mkdir_p(database_dir)
    File.write(File.join(database_dir, "events.sql"),
      "ATTACH TABLE _ UUID '#{table_uuid}'\n(\n    `pk` UInt64,\n    `payload` #{declaration}\n)\nENGINE = MergeTree\nORDER BY `pk`\n")
    table_dir = File.join(catalog, "store", table_uuid[0, 3], table_uuid)
    FileUtils.mkdir_p(table_dir)
    FileUtils.mkdir_p(File.join(table_dir, "detached"))
    File.write(File.join(table_dir, "format_version.txt"), "1\n")
    destination = File.join(table_dir, part.name)
    assert(!File.exists?(destination) && !File.symlink?(destination), "#{label}: detached catalog part destination is occupied")
    FileUtils.cp_r(part.path, destination)
    {catalog, File.realpath(destination)}
  end

  private def assert_catalog_and_pk(catalog_root : String, copied_part : String, part : Part, docs : Array(Document), label : String) : Nil
    selection = CrystalClick::OfflineCatalog.open(catalog_root)["lab"]["events"]["payload"]
    values = selection.values.map(&.as(Document))
    assert_documents(docs, values, "#{label} OfflineCatalog.values")
    nested = values[1].value_for("tuple_named").element_at(0).bytes
    nested[0] ^= 1_u8
    reread = selection.values[1].as(Document).value_for("tuple_named").element_at(0).bytes
    assert(reread == docs[1].value_for("tuple_named").element_at(0).bytes,
      "#{label}: mutating a nested detached byte snapshot changed catalog values")

    table = CrystalClick::OfflineCatalog.open(catalog_root).table("lab", "events")
    parts = table.resolved_scan_parts
    assert(parts.map(&.name) == [part.name] && parts[0].path == copied_part, "#{label}: catalog part resolution differs")
    candidates = [] of Tuple(Array(UInt64), Array(Document))
    table.scan_uint64_pk_candidates(["pk", "payload"], lower_bound: 6_u64, upper_bound: 6_u64) do |batch|
      candidates << {batch.values_for("pk").to_a, batch.object_documents_for("payload").to_a}
      nil
    end
    assert(candidates.size == 1 && candidates[0][0] == [5_u64, 6_u64], "#{label}: PK=6 candidate granule differs")
    assert_documents([docs[4], docs[5]], candidates[0][1], "#{label} PK candidate granule")
    exact = [] of Document
    candidates.each do |keys_and_docs|
      keys = keys_and_docs[0]
      documents = keys_and_docs[1]
      keys.each_with_index { |key, index| exact << documents[index] if key == 6_u64 }
    end
    assert_documents([docs[5]], exact, "#{label} exact PK residual")
  end

  private def replace_field(document : Document, path : String, replacement : Value) : Document
    values = {} of String => Value
    document.paths.each { |name| values[name] = name == path ? replacement : document.value_for(name) }
    Document.new(values)
  end

  private def assert_comparator_controls(fields : Array(Field), docs : Array(Document), expected_full : String, label : String) : Nil
    named = fields.find! { |field| field.name == "tuple_named" }
    original = docs[0].value_for(named.name)
    unnamed_type = DataType.tuple([DataType.primitive("UInt16"), DataType.primitive("String")] of DataType)
    wrong_nominal = Value.tuple(unnamed_type, original.elements)
    wrong_document = replace_field(docs[0], named.name, wrong_nominal)
    expect_mismatch("named-versus-unnamed Tuple identity") do
      assert_documents([docs[0]], [wrong_document], "seeded tuple type identity")
    end
    expect_mismatch("row/order permutation") do
      assert_documents(docs, docs.reverse, "seeded row order")
    end
    u16_field = fields.find! { |field| field.name == "arr_u16" }
    altered_values = docs[0].value_for(u16_field.name).elements
    bytes = altered_values[0].bytes
    bytes[0] ^= 1_u8
    altered_values[0] = Value.fixed(altered_values[0].type, bytes)
    altered_array = Value.array(docs[0].value_for(u16_field.name).type, altered_values)
    expect_mismatch("nested UInt16 value/byte mutation") do
      assert_documents([docs[0]], [replace_field(docs[0], u16_field.name, altered_array)], "seeded value and byte mutation")
    end
    truncated = String.new(expected_full.to_slice[0, expected_full.bytesize - 1])
    expect_mismatch("truncated RowBinary witness") do
      assert(expected_full.to_slice == truncated.to_slice, "seeded RowBinary truncation comparator")
    end
    expect_mismatch("CHECK result mismatch") do
      check_line = "all_1_1_0\t0\t"
      columns = check_line.split('\t', remove_empty: false)
      assert(columns.size == 3 && columns[1] == "1" && columns[2].empty?, "seeded CHECK mismatch comparator")
    end
  end

  private def cell_record(root : String, label : String, direction : String, profile_name : String, mode_name : String) : CellRecord
    store = File.join(root, "stores", label)
    result = File.join(root, "results", label)
    FileUtils.mkdir_p(store)
    FileUtils.mkdir_p(result)
    table = table_name(label)
    record = CellRecord.new(
      label, direction, profile_name, mode_name, store, table,
      File.join(result, "expected-full.rowbinary"), File.join(result, "actual-full.rowbinary"),
      File.join(result, "expected-middle.rowbinary"), File.join(result, "actual-middle.rowbinary")
    )
    @manifest_cells << record
    write_manifest(root, type_roster)
    record
  end

  private def finish_cell(root : String, record : CellRecord, part : Part, table_data_path : String,
                          catalog_root : String, catalog_part_path : String, logical : Array(String), checksums : Array(String)) : Nil
    record.part_name = part.name
    record.part_path = part.path
    record.table_data_path = table_data_path
    record.catalog_root = catalog_root
    record.catalog_part_path = catalog_part_path
    record.stream_names = logical
    record.checksum_names = checksums
    record.state = "complete"
    write_manifest(root, type_roster)
  end

  private def native_case(
    binary : String, root : String, fields : Array(Field), schema : CrystalClick::ObjectDocumentSchema,
    docs : Array(Document), profile_name : String, profile : CrystalClick::BinaryBulkProfile,
    mode_name : String, mode : UInt64, cell_number : Int32,
  ) : Nil
    label = "native_#{profile_name}_#{mode_name}"
    record = cell_record(root, label, "native JSONEachRow -> library reader/catalog", profile_name, mode_name)
    result_dir = File.dirname(record.expected_full)
    create_table(binary, record.store, record.table, schema.declaration, profile_name, mode,
      result_dir, label)
    fixture_path = File.join(result_dir, "input.jsonl")
    File.write(fixture_path, all_rows_json)
    click(binary, record.store, "INSERT INTO default.#{record.table} FORMAT JSONEachRow",
      "#{result_dir}/insert", IO::Memory.new(all_rows_json))
    part = stock_part(binary, record.store, record.table, result_dir, label)
    assert_check(binary, record.store, record.table, result_dir, label, part.name)
    assert_type_names(binary, record.store, record.table, fields, "#{result_dir}/type-names", label)
    _full, _middle = assert_native_rowbinary(binary, record.store, record.table, fields, result_dir, label)
    data_path = click(binary, record.store,
      "SELECT data_paths[1] FROM system.tables WHERE database='default' AND name='#{record.table}' FORMAT TSVRaw",
      "#{result_dir}/table-data-path").strip
    verify_part_path(part.path, record.store, label)
    profile = profile_name == "single_stream" ? CrystalClick::BinaryBulkProfile.single_stream : CrystalClick::BinaryBulkProfile.with_size_stream
    logical, checksums = assert_reader(part, schema, fields, docs, profile, mode, label)
    catalog, copied = catalog_root(root, label, cell_number, part, schema.declaration)
    assert_catalog_and_pk(catalog, copied, part, docs, label)
    record.state = "complete"
    finish_cell(root, record, part, data_path, catalog, copied, logical, checksums)
    puts "PASS W140 native JSONEachRow -> stock CHECK / independent RowBinary / recursive reader / catalog PK residual: #{label}"
  end

  private def library_case(
    binary : String, root : String, fields : Array(Field), schema : CrystalClick::ObjectDocumentSchema,
    docs : Array(Document), profile_name : String, profile : CrystalClick::BinaryBulkProfile,
    mode_name : String, mode : UInt64, cell_number : Int32,
  ) : Nil
    label = "library_#{profile_name}_#{mode_name}"
    record = cell_record(root, label, "library writer -> stock ATTACH", profile_name, mode_name)
    result_dir = File.dirname(record.expected_full)
    create_table(binary, record.store, record.table, schema.declaration, profile_name, mode,
      result_dir, label)
    active_before = click(binary, record.store,
      "SELECT count() FROM system.parts WHERE database='default' AND table='#{record.table}' AND active FORMAT TSVRaw",
      "#{result_dir}/active-before").strip
    assert(active_before == "0", "#{label}: target table is not empty before library part publication")
    data_path = click(binary, record.store,
      "SELECT data_paths[1] FROM system.tables WHERE database='default' AND name='#{record.table}' FORMAT TSVRaw",
      "#{result_dir}/table-data-path").strip
    verify_part_path(data_path, record.store, "#{label} table data path")
    detached = File.join(data_path, "detached")
    FileUtils.mkdir_p(detached)
    part_name = "all_1_1_0"
    part_path = File.join(detached, part_name)
    assert(!File.exists?(part_path) && !File.symlink?(part_path), "#{label}: detached part target is already occupied")
    CrystalClick::WidePartWriter.write_uint64_object_pair(
      part_path, "pk", Slice(UInt64).new(KEYS.size) { |index| KEYS[index] },
      "payload", schema, object_plan(schema), expected_marks(docs), rows_per_mark: 2,
      mode: mode, profile: profile, shared_profile: CrystalClick::BinaryBulkProfile.single_stream,
      frame_bytes: FRAME_BYTES
    )
    part_path = verify_part_path(part_path, record.store, "#{label} library part")
    click(binary, record.store, "ALTER TABLE default.#{record.table} ATTACH PART '#{part_name}'",
      "#{result_dir}/attach")
    part = stock_part(binary, record.store, record.table, result_dir, label)
    assert(part.name == part_name, "#{label}: ATTACH changed library part identity")
    assert_check(binary, record.store, record.table, result_dir, label, part.name)
    assert_type_names(binary, record.store, record.table, fields, "#{result_dir}/type-names", label)
    _full, _middle = assert_native_rowbinary(binary, record.store, record.table, fields, result_dir, label)
    logical, checksums = assert_reader(part, schema, fields, docs, profile, mode, label)
    catalog, copied = catalog_root(root, label, cell_number, part, schema.declaration)
    assert_catalog_and_pk(catalog, copied, part, docs, label)
    finish_cell(root, record, part, data_path, catalog, copied, logical, checksums)
    puts "PASS W140 library writer -> stock ATTACH/CHECK / independent RowBinary / recursive reader / catalog PK residual: #{label}"
  end

  private def object_plan(schema : CrystalClick::ObjectDocumentSchema) : CrystalClick::ObjectDocumentPlan
    int64 = DataType.primitive("Int64")
    object = CrystalClick::ObjectStructure.new(["d"] of String)
    dynamics = {"d" => CrystalClick::DynamicStructure.new([int64])} of String => CrystalClick::DynamicStructure
    CrystalClick::ObjectDocumentPlan.new(CrystalClick::ObjectDynamicStructureSet.new(object, dynamics), schema.typed_paths)
  end

  def initialize
    @manifest_cells = [] of CellRecord
  end

  def check : Nil
    binary = ENV["CLICKHOUSE_BIN"]? || "/private/tmp/crystal-click-w112-runtime.u0Jn1f/clickhouse"
    root_arg = ENV["W140_TMP_ROOT"]? || ENV["W140_PROBE_ROOT"]? || raise "W140_TMP_ROOT or W140_PROBE_ROOT is required"
    root = assert_safe_root(root_arg)
    assert(File.executable?(binary), "pinned ClickHouse executable is unavailable: #{binary}")
    FileUtils.mkdir_p(File.join(root, "stores"))
    FileUtils.mkdir_p(File.join(root, "results"))
    FileUtils.mkdir_p(File.join(root, "stores", "identity"))
    fields = type_roster
    assert(fields.map(&.name).uniq.size == fields.size && fields.size == 13, "W140 explicit field roster changed")
    assert(KEYS.size == FIXTURE_ROWS.size && KEYS.size == 7 && ROWS_PER_MARK == [2_u64, 2_u64, 2_u64, 1_u64],
      "W140 literal seven-row/2,2,2,1 fixture changed")
