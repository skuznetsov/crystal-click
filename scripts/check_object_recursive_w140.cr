  private def uint_bytes(value : UInt64, width : Int) : Bytes
    Bytes.new(width) do |index|
      ((value >> (index * 8)) & 0xff_u64).to_u8
    end
  end

  private def var_uint(io : IO, value : UInt64) : Nil
    remaining = value
    while remaining >= 0x80_u64
      io.write_byte((remaining & 0x7f_u64).to_u8 | 0x80_u8)
      remaining >>= 7
    end
    io.write_byte(remaining.to_u8)
  end

  private def value_for(json : JSON::Any, type : DataType) : Value
    case type.tag
    when DataType::TAG_ARRAY
      children = json.as_a.map { |entry| value_for(entry, type.child_at(0)) }
      Value.array(type, children)
    when DataType::TAG_MAP
      flat = [] of Value
      json.as_h.each do |key, child|
        flat << Value.string(key)
        flat << value_for(child, type.child_at(1))
      end
      Value.map(type, flat)
    when DataType::TAG_UNNAMED_TUPLE, DataType::TAG_NAMED_TUPLE
      values = json.as_a
      assert(values.size == type.child_count, "fixture tuple arity differs from descriptor")
      Value.tuple(type, values.each_with_index.map { |entry, i| value_for(entry, type.child_at(i)) }.to_a)
    when DataType::TAG_NULLABLE
      if json.raw.nil?
        Value.nullable(type)
      else
        Value.nullable(type, value_for(json, type.child_at(0)))
      end
    when DataType::TAG_STRING
      Value.string(json.as_s)
    when DataType::TAG_UINT8, DataType::TAG_UINT16
      width = type.fixed_width.not_nil!
      Value.fixed(type, uint_bytes(json.as_i.to_u64, width))
    when DataType::TAG_ENUM8
      label = json.as_s
      code = case label
             when "off" then 0_u64
             when "on"  then 1_u64
             else            fail("unknown literal Enum8 label #{label.inspect}")
             end
      Value.fixed(type, uint_bytes(code, 1))
    when DataType::TAG_DATETIME64_ZONE, DataType::TAG_DATETIME64
      assert(json.as_s == EVENT_AT, "unexpected event timestamp in literal fixture")
      Value.fixed(type, bytes_from_hex(EVENT_AT_HEX))
    else
      fail("fixture builder has no independent literal mapping for type tag #{type.tag}")
    end
  end

  private def bytes_from_hex(hex : String) : Bytes
    source = hex.to_slice
    assert(source.size.even?, "literal hex has an odd digit count")
    Bytes.new(source.size // 2) do |index|
      high = source[index * 2]
      low = source[index * 2 + 1]
      ((hex_nibble(high) << 4) | hex_nibble(low))
    end
  end

  private def hex_nibble(byte : UInt8) : UInt8
    if byte >= '0'.ord.to_u8 && byte <= '9'.ord.to_u8
      byte - '0'.ord.to_u8
    elsif byte >= 'a'.ord.to_u8 && byte <= 'f'.ord.to_u8
      byte - 'a'.ord.to_u8 + 10_u8
    else
      fail("invalid hex digit #{byte}")
    end
  end

  private def document(index : Int32, fields : Array(Field)) : Document
    payload = json_payload(index).as_h
    values = {} of String => Value
    fields.each do |field|
      json = if field.name == "tuple_empty" && !payload.has_key?(field.name)
               JSON.parse("[]")
             else
               payload[field.name]? || raise Mismatch.new("literal row #{index} lacks typed field #{field.name}")
             end
      values[field.name] = value_for(json, field.type)
    end
    values["d"] = Value.int64(payload["d"].as_i.to_i64)
    if spill = payload["spill"]?
      values["spill"] = Value.string(spill.as_s)
    end
    Document.new(values)
  end

  private def expected_documents(fields : Array(Field)) : Array(Document)
    Array(Document).new(KEYS.size) { |index| document(index.to_i32, fields) }
  end

  private def expected_marks(documents : Array(Document)) : Array(Array(Document))
