# W140 paired recursive Object interoperability oracle.
#
# Expected values originate in the literal JSONEachRow fixture below. The
# RowBinary witness is independently encoded here from the bounded fixture
# grammar; it is not generated by BinaryBulkCodec or by a ClickHouse SELECT.
require "file_utils"
require "json"
require "../src/crystal_click"

class W140RecursiveOracle
  class Mismatch < Exception
  end

  struct Field
    getter name : String
    getter type_name : String
    getter type : CrystalClick::BinaryDataType

    def initialize(@name : String, @type_name : String, @type : CrystalClick::BinaryDataType)
    end
  end

  struct Part
    getter name : String
    getter path : String
    getter rows : UInt64

    def initialize(@name : String, @path : String, @rows : UInt64)
    end
  end

