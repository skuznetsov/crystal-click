 bool ReadBufferFromFileDescriptor::checkIfActuallySeekable()
 {
     struct stat stat{};
+#ifdef CLICKHOUSE_READ_ROWS_PROFILE
+    ReadRowsProfile::Timer timer(ReadRowsProfile::Operation::FStat);
+    const auto res = ::fstat(fd, &stat);
+    const int saved_errno = errno;
+    timer.finish();
+    errno = saved_errno;
+#else
     auto res = ::fstat(fd, &stat);
+#endif
     return res == 0 && S_ISREG(stat.st_mode);
 }

