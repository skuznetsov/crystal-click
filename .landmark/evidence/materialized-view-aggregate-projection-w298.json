  "claim": {
    "level": "VERIFIED",
    "scope": "Ordered, distinct plain UInt64 GROUP BY keys in aggregate projections with one to four caller-computed Count, Sum, Min and Max states. Plain Wide MRK2 and Compact MRK4 children with either parent layout and raw compound primary indexes.",
    "adversary": "ROBUST for the four native layout pairings and the staged writer and admission cases below.",
    "remaining": "Crystal typed scans use row windows. The Compact reader checks index shape and hidden lane spans. The staged writer checks index values, and the native audit checks both values and ClickHouse pruning. The exercised Wide aggregate transport uses plain MRK2 marks."
  },
  "risk": {
    "tier": "CAUTION",
    "strongest_failure": "A child passes ATTACH and CHECK but a later key points at the wrong state or prunes a valid group.",
    "guards": [
      "Compare each mark-start tuple and the terminal tuple with the key lanes. Mutate a fourth key cell in a middle tuple and in the terminal tuple, regenerate the checksum and require both to fail staged validation.",
      "Reject wrong GROUP BY order, duplicate and descending tuples distinguished by their last key, bad hidden key spans outside a selected window, mixed siblings with different ordered key rosters even at EOF, and a simultaneous primary.cidx.",
      "Check detached snapshots and reject an insufficient shared write budget before preparing Wide key carriers.",
      "Recompute group states, index values, query rows, and mark counters from native captures. Reopen stock and attached parts in Crystal."
    ],
    "rollback": "Revert the feature commit. Parent and child staging share a single atomic publication."
  },
