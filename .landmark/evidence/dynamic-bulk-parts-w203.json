    "no_cartesian_serializers": true,
    "publication": "Preflight/encode before staging; shared static Nested/Dynamic publisher validates exact roster, checksums, grids, keys/index and public full-value readback before exclusive publication. No overwrite; own-stage cleanup.",
    "discovery": "Parent-first loader uses already-parsed ancestor actual rosters, bounded canonical arm names and one retained prepared plan. Physical plan must retain the exact supplied prepared plan.",
    "metadata": "Present selected root Tuple entry requires Default recursive subcolumns with exact schema arity, valid counts and depth/node limits. Omitted entire selected entry retains Default fallback; legacy Object parsing remains strict.",
    "lc": "Complete dictionary replay for later/zero windows when a persisted ordinary roster contains LC; selected decoder offset still refers to the requested parent marks.",
    "architecture": "Separate column writer/reader, site-name resolver, Tuple-metadata validator, input plans and common publisher/lane/role/input owners. Not repository-wide decomposition."
  },
  "boundaries": {
    "risk": "CAUTION: public storage API, metadata state and persisted layouts.",
    "rollback": "Revert only the scoped atomic local feature commit; no push/history rewrite or stock checkout mutation.",
    "budget_scope": "Cumulative codec and transport budgets across the owned Dynamic column operation; separate existing metadata/key/index limits. Not whole-part/process RSS or no-I/O rejection.",
    "reader_integrity": "Quiescent parts. Declared file sizes and consumed compressed-frame checksums are authenticated; whole unselected data-file authentication is not promised.",
    "strongest_failure": "Shared Crystal encoder/decoder agree on wrong actual/shared placement, prefix or mark boundary. Independent stock values/type/shared-state, exact manifests and seeded selected-window failure discriminate it.",
    "nonclaims": [
      "Every legal recursive product, dictionary lifecycle/schedule or every malformed case through the public API.",
      "JSON-containing descriptors, JSON-as-Dynamic-actual, COMPACT Variant, illegal CH nesting, Compact/legacy/flattened specialized layouts.",
      "Automatic OfflineTable/catalog dispatch or arbitrary complete schemas through this direct two-column API.",
      "All-type compatibility, full MV/projections, repository-wide class decomposition, performance improvement or overall goal completion.",
      "Independent reimplementation of physical filename hashing; exact manifest names, role/name bindings and hashed bin/mrk2 pair census are the native oracle scope."
    ],
    "coverage": "New public tests exercise Tuple metadata, nominal/source roster/window guards, plan identity, budgets and failed publication. The unchanged affected codec/transport suite exercises retained layout/state guards; not every malformed case is re-instantiated as a public complete part."
  },
